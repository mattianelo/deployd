  <releases>
    <release version="0.9.3" date="2026-03-10" type="development">
      <description>
        <p>Fixes a crash when switching the downloads sort order while a download is in progress.
        Adds self-update support: when an update is available and deployd is running as an AppImage,
        a "Download Update" button appears in the banner to download and apply the update in-place.</p>
      </description>
    </release>
    <release version="0.9.2" date="2026-03-09" type="development">
