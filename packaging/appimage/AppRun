#!/bin/bash
# AppRun for Deployd AppImage
# Handles system registration and GTK4 environment setup before launching.

set -euo pipefail

# $APPDIR and $APPIMAGE are set by the AppImage Type 2 runtime before AppRun
# is executed. Use them directly; fall back to dirname of $0 only for manual
# testing where the runtime isn't involved.
APPDIR="${APPDIR:-$(cd "$(dirname "$0")" && pwd)}"
APP_ID="deployd"
MARKER_DIR="$HOME/.local/share/deployd"
MARKER="$MARKER_DIR/.appimage-registration"

# ---------------------------------------------------------------------------
# System integration registration
# ---------------------------------------------------------------------------
# Re-register whenever the AppImage path changes (first run, moved, renamed).
# $APPIMAGE is the absolute path to the AppImage file, set by the runtime.
CURRENT_APPIMAGE="${APPIMAGE:-$0}"

needs_registration() {
    [ ! -f "$MARKER" ] || [ "$(cat "$MARKER" 2>/dev/null)" != "$CURRENT_APPIMAGE" ]
}

register_integration() {
    local APPS_DIR="$HOME/.local/share/applications"
    local ICON_DIR="$HOME/.local/share/icons/hicolor/scalable/apps"

    mkdir -p "$APPS_DIR" "$ICON_DIR" "$MARKER_DIR"

    # Install desktop file with Exec pointing to this AppImage
    sed "s|Exec=deployd|Exec=$CURRENT_APPIMAGE|g" \
        "$APPDIR/usr/share/applications/$APP_ID.desktop" \
        > "$APPS_DIR/$APP_ID.desktop"

    # Install icon
    cp "$APPDIR/usr/share/icons/hicolor/scalable/apps/$APP_ID.svg" \
        "$ICON_DIR/$APP_ID.svg"

    # Refresh desktop and icon caches (failures are non-fatal)
    update-desktop-database "$APPS_DIR" 2>/dev/null || true
    gtk-update-icon-cache -f "$HOME/.local/share/icons/hicolor" 2>/dev/null || true

    # Register nxm:// protocol handler
    xdg-mime default "$APP_ID.desktop" x-scheme-handler/nxm 2>/dev/null || true

    # Store marker so we only re-register when the path changes
    echo "$CURRENT_APPIMAGE" > "$MARKER"
}

if needs_registration; then
    register_integration
fi

# ---------------------------------------------------------------------------
# GTK4 / libadwaita environment setup
# ---------------------------------------------------------------------------
export GSETTINGS_SCHEMA_DIR="$APPDIR/usr/share/glib-2.0/schemas${GSETTINGS_SCHEMA_DIR:+:$GSETTINGS_SCHEMA_DIR}"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# GDK pixbuf loaders cache (only set if bundled — falls back to system otherwise)
PIXBUF_CACHE=$(find "$APPDIR/usr/lib" -name "loaders.cache" 2>/dev/null | head -1)
if [ -n "$PIXBUF_CACHE" ]; then
    export GDK_PIXBUF_MODULE_FILE="$PIXBUF_CACHE"
fi

# ---------------------------------------------------------------------------
# Launch
# ---------------------------------------------------------------------------
exec "$APPDIR/usr/bin/deployd" "$@"
